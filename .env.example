# Copy this file to .env (or export these as real environment variables)
# and never commit the real values.

# Shared passphrase used to derive the AES-256-GCM key for encrypting
# chat messages. Every FRN Chat client that needs to read each other's
# messages must be configured with the SAME value, agreed on out-of-band
# (e.g. shared privately between you and the people you're chatting with).
# If this variable is not set, the client will prompt for it at startup instead.
FRN_CHAT_SECRET=
